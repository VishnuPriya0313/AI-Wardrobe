# AI provider: use openai for deployment, ollama for local experiments.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
SERPAPI_API_KEY=replace_with_your_serpapi_key

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava
OLLAMA_MATCH_MODEL=llama3.2:3b

PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-frontend-domain.pages.dev
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/ai_wardrobe
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace_with_database_password
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=1
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=30d
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Required for email verification. For Gmail, use an App Password, not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace_with_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
EMAIL_VERIFICATION_TTL=24h

# Google OAuth Web application credentials. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_S3_ENABLED=true
APP_S3_BUCKET=your-wardrobe-bucket
APP_S3_REGION=auto
APP_S3_KEY_PREFIX=wardrobe-uploads
APP_S3_PUBLIC_BASE_URL=
APP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
